# 运行环境：development / production 等
APP_ENV=development

# 异步 PostgreSQL 连接串（宿主机端口 39432，对应 docker-compose 映射）
DATABASE_URL=postgresql+asyncpg://luxumbra:luxumbra@localhost:39432/luxumbra

# Redis 连接串（宿主机端口 39379，对应 docker-compose 映射）
REDIS_URL=redis://localhost:39379/0

# DeepSeek 使用 OpenAI 兼容接口；密钥只写入本地 .env，不得提交
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 默认关闭思考模式以缩短大纲等待时间，复杂主题可按需开启
LLM_THINKING_ENABLED=false
LLM_TIMEOUT_SECONDS=60

# AI 生图；与 LLM 凭证独立，可不配。IMAGE_PROVIDER=openai | bailian
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

# 百炼（qwen-image-3.0 不走 OpenAI 兼容模式）：
# IMAGE_PROVIDER=bailian
# IMAGE_API_KEY=sk-xxx
# IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# IMAGE_MODEL=qwen-image-3.0
# 可选：业务空间 ID，填写后改用 https://{id}.cn-beijing.maas.aliyuncs.com/api/v1
IMAGE_WORKSPACE_ID=
IMAGE_TIMEOUT_SECONDS=60

# HTML 报告会在写网页前自动准备的配图数量；0 表示关闭自动配图。
# 图片统一先保存为项目媒体，下载 HTML 时自动内嵌，离线打开也能看到。
HTML_REPORT_IMAGE_COUNT=2
# 单文件 HTML 导出中可内嵌的图片总大小上限（MB）
HTML_EXPORT_EMBED_MEDIA_MAX_MB=24

# 外部 Template/*.pptx 的按需 AI 解析。默认复用 IMAGE_API_KEY；如需分账可填写独立 Key。
# Qwen-VL 走百炼 OpenAI-compatible 接口，DeepSeek 的风格/文本总结复用上方 LLM_*。
TEMPLATE_VISION_API_KEY=
TEMPLATE_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEMPLATE_VISION_MODEL=qwen3-vl-plus
TEMPLATE_ANALYSIS_MAX_IMAGES=24

# Unsplash 图库 Access Key；生图不可用时降级到此，也可单独使用
UNSPLASH_ACCESS_KEY=

# 单张配图体积上限（MB）
MAX_IMAGE_MB=8

# 允许跨域的前端源列表（JSON 数组）
CORS_ORIGINS=["http://localhost:39173"]

# JWT 签名密钥（HS256）。生产环境必须替换，可用：openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me

# JWT 签名算法
JWT_ALGORITHM=HS256

# access token 过期时间（分钟），默认 7 天；本项目不做 refresh token
JWT_EXPIRE_MINUTES=10080

# 对象存储驱动：local 落盘到 backend/var/storage，cos 走腾讯云
# 选 cos 需额外安装 SDK：uv add cos-python-sdk-v5
STORAGE_DRIVER=local
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=

# 单个上传文件的体积上限（MB）
MAX_UPLOAD_MB=10
