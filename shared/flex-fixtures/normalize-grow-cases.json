{
  "cases": [
    {
      "name": "竖拉把下方块压到内容软下限：后端会抬回 GROW_MIN 并重分配",
      "tree": {
        "type": "column",
        "id": "root",
        "gap_pt": 16.0,
        "grow": 1.0,
        "children": [
          {
            "type": "block",
            "id": "title",
            "block_id": "title",
            "grow": 0.5,
            "text_style": "title"
          },
          {
            "type": "block",
            "id": "body",
            "block_id": "body",
            "grow": 1.9
          },
          {
            "type": "block",
            "id": "pic",
            "block_id": "pic",
            "grow": 0.1
          }
        ]
      },
      "expected_grows": {
        "root": 1.0,
        "title": 0.5660377358490566,
        "body": 2.150943396226415,
        "pic": 0.2830188679245283
      }
    },
    {
      "name": "列内含 spacer：占位锁定，内容绝对权重不变",
      "tree": {
        "type": "column",
        "id": "root",
        "gap_pt": 0.0,
        "grow": 1.0,
        "children": [
          {
            "type": "block",
            "id": "body",
            "block_id": "body",
            "grow": 2.4
          },
          {
            "type": "column",
            "id": "spacer-tail",
            "children": [],
            "gap_pt": 0.0,
            "grow": 0.0
          }
        ]
      },
      "expected_grows": {
        "root": 1.0,
        "body": 2.4,
        "spacer-tail": 0.0
      }
    },
    {
