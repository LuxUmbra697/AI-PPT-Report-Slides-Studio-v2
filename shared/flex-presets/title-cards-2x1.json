{
  "id": "title-cards-2x1",
  "name": "标题 + 2+1 卡片",
  "description": "上两列要点/卡片，下一行宽卡，对标混排",
  "tree": {
    "type": "column",
    "id": "root",
    "gap_pt": 14,
    "grow": 1.0,
    "children": [
      {
        "type": "block",
        "id": "leaf-kicker",
        "block_id": "kicker",
        "grow": 0.25,
        "text_style": "caption"
      },
      {
        "type": "block",
        "id": "leaf-title",
        "block_id": "title",
        "grow": 0.45,
        "text_style": "title"
      },
      {
        "type": "row",
        "id": "top-row",
        "gap_pt": 16,
        "grow": 1.0,
        "ratios": [50, 50],
        "preset": "outline_boxes",
        "children": [
          {
            "type": "block",
            "id": "leaf-body-left",
            "block_id": "body_left",
            "grow": 1.0,
            "text_style": "bullet"
          },
          {
            "type": "block",
            "id": "leaf-body-right",
            "block_id": "body_right",
            "grow": 1.0,
            "text_style": "bullet"
          }
        ]
      },
      {
        "type": "column",
        "id": "bottom-card",
        "gap_pt": 0,
        "grow": 0.9,
        "preset": "solid_boxes",
        "children": [
          {
            "type": "block",
            "id": "leaf-cards",
            "block_id": "cards",
            "grow": 1.0
          }
        ]
      }
    ]
  }
}
