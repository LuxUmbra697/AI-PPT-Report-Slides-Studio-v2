{
  "id": "title-image-cards",
  "name": "标题 + 三连图卡",
  "description": "小图 + 小标题描述横排三列",
  "tree": {
    "type": "column",
    "id": "root",
    "gap_pt": 14,
    "grow": 1.0,
    "children": [
      {
        "type": "block",
        "id": "leaf-kicker",
        "block_id": "kicker",
        "grow": 0.25,
        "text_style": "caption"
      },
      {
        "type": "block",
        "id": "leaf-title",
        "block_id": "title",
        "grow": 0.4,
        "text_style": "title"
      },
      {
        "type": "row",
        "id": "image-row",
        "gap_pt": 16,
        "grow": 1.8,
        "ratios": [33, 33, 34],
        "preset": "outline_boxes",
        "children": [
          {
            "type": "column",
            "id": "col-1",
            "gap_pt": 8,
            "grow": 1.0,
            "children": [
              {
                "type": "block",
                "id": "leaf-image",
                "block_id": "image",
                "grow": 1.2
              },
              {
                "type": "block",
                "id": "leaf-body-left",
                "block_id": "body_left",
                "grow": 0.8,
                "text_style": "bullet"
              }
            ]
          },
          {
            "type": "column",
            "id": "col-2",
            "gap_pt": 8,
            "grow": 1.0,
            "children": [
              {
                "type": "block",
                "id": "leaf-visual",
                "block_id": "visual",
                "grow": 1.2
              },
              {
                "type": "block",
                "id": "leaf-body-right",
                "block_id": "body_right",
                "grow": 0.8,
                "text_style": "bullet"
              }
            ]
          },
          {
            "type": "column",
            "id": "col-3",
            "gap_pt": 8,
            "grow": 1.0,
            "children": [
              {
                "type": "block",
                "id": "leaf-cards",
                "block_id": "cards",
                "grow": 1.2
              },
              {
                "type": "block",
                "id": "leaf-body",
                "block_id": "body",
                "grow": 0.8,
                "text_style": "bullet"
              }
            ]
          }
        ]
      }
    ]
  }
}
